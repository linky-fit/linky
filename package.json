{
  "name": "linky",
  "private": true,
  "license": "0BSD",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d --wait && bun run --filter @linky-fit/linky-app --filter @linky-fit/push dev",
    "dev:prod": "bun run --filter @linky-fit/linky-app dev:prod",
    "dev:services": "docker compose -f docker-compose.dev.yml up",
    "build": "bun run --filter @linky-fit/linky-app build",
    "preview": "bun run --filter @linky-fit/linky-app preview",
    "site:dev": "bun run --filter @linky-fit/linky-site dev",
    "site:build": "bun run --filter @linky-fit/linky-site build",
    "site:preview": "bun run --filter @linky-fit/linky-site preview",
    "zapstore:screenshots": "bun run --filter @linky-fit/linky-site zapstore:screenshots",
    "fazole:dev": "bun run --filter @linky-fit/fazole-app dev",
    "fazole:build": "bun run --filter @linky-fit/fazole-app build",
    "fazole-site:dev": "bun run --filter @linky-fit/fazole-site dev",
    "fazole-site:build": "bun run --filter @linky-fit/fazole-site build",
    "errors:dev": "bun run --filter @linky-fit/nostr-error-tracker dev",
    "desktop:dev": "bun run --filter @linky-fit/desktop dev",
    "desktop:mac": "bun run --filter @linky-fit/desktop dist:mac",
    "native:android:release:check": "bun run --filter @linky-fit/native-shell android:release:check",
    "native:android:icons": "bun run --filter @linky-fit/native-shell android:icons",
    "native:android:add": "bun run --filter @linky-fit/native-shell android:add",
    "native:android:sync": "bun run --filter @linky-fit/native-shell android:sync",
    "native:android:open": "bun run --filter @linky-fit/native-shell android:open",
    "native:apk:debug": "bun run --filter @linky-fit/native-shell android:apk:debug",
    "native:apk:release": "bun run --filter @linky-fit/native-shell android:apk:release",
    "native:aab:release": "bun run --filter @linky-fit/native-shell android:aab:release",
    "native:ios:add": "bun run --filter @linky-fit/native-shell ios:add",
    "native:ios:sync": "bun run --filter @linky-fit/native-shell ios:sync",
    "native:ios:open": "bun run --filter @linky-fit/native-shell ios:open",
    "linkshu": "bun apps/linkshu-cli/src/index.ts",
    "push:dev": "bun run --filter @linky-fit/push dev",
    "push:start": "bun run --filter @linky-fit/push start",
    "eslint": "bun run --workspaces --if-present eslint",
    "prettier": "bun run --workspaces --if-present prettier",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "e2e": "bash scripts/e2e.sh",
    "check-code": "bun run typecheck && bun run eslint && bun run prettier",
    "check-changed": "bash scripts/changed.sh typecheck eslint prettier",
    "test-changed": "bash scripts/changed.sh test",
    "build:npm": "bun run --filter @linky-fit/linkshu --filter @linky-fit/linkstr --filter @linky-fit/linkauth build:npm",
    "check:npm": "bash packages/config/npm/check.sh",
    "ui:dev": "bun run --filter @linky-fit/ui-book dev"
  },
  "patchedDependencies": {
    "bysquare@4.0.0": "patches/bysquare@4.0.0.patch",
    "@evolu/sqlite-wasm@2.2.4": "patches/@evolu%2Fsqlite-wasm@2.2.4.patch"
  }
}
