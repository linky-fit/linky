{
  "name": "linky",
  "private": true,
  "version": "26.9.7",
  "license": "0BSD",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d --wait && bun run --filter @linky/web-app --filter @linky/push dev",
    "dev:prod": "bun run --filter @linky/web-app dev:prod",
    "dev:services": "docker compose -f docker-compose.dev.yml up",
    "build": "bun run --filter @linky/web-app build",
    "preview": "bun run --filter @linky/web-app preview",
    "site:dev": "bun run --filter @linky/site dev",
    "site:build": "bun run --filter @linky/site build",
    "site:preview": "bun run --filter @linky/site preview",
    "errors:dev": "bun run --filter @linky/nostr-error-tracker dev",
    "native:android:release:check": "bun run --filter @linky/native-shell android:release:check",
    "native:android:icons": "bun run --filter @linky/native-shell android:icons",
    "native:android:add": "bun run --filter @linky/native-shell android:add",
    "native:android:sync": "bun run --filter @linky/native-shell android:sync",
    "native:android:open": "bun run --filter @linky/native-shell android:open",
    "native:apk:debug": "bun run --filter @linky/native-shell android:apk:debug",
    "native:apk:release": "bun run --filter @linky/native-shell android:apk:release",
    "native:aab:release": "bun run --filter @linky/native-shell android:aab:release",
    "native:ios:add": "bun run --filter @linky/native-shell ios:add",
    "native:ios:sync": "bun run --filter @linky/native-shell ios:sync",
    "native:ios:open": "bun run --filter @linky/native-shell ios:open",
    "linkshu": "bun apps/linkshu-cli/src/index.ts",
    "push:dev": "bun run --filter @linky/push dev",
    "push:start": "bun run --filter @linky/push start",
    "eslint": "bun run --workspaces --if-present eslint",
    "prettier": "bun run --workspaces --if-present prettier",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "check-code": "bun run typecheck && bun run eslint && bun run prettier"
  },
  "patchedDependencies": {
    "nostr-tools@2.23.3": "patches/nostr-tools@2.23.3.patch"
  }
}
