NPUBCASH_V1_PORT=8788
# v3's Postgres database; this service adds only the v1_claims table.
NPUBCASH_V1_DATABASE_URL=postgres://npubcash:password@localhost:5432/npubcash
# 32+ bytes of hex. Back it up like a wallet seed and keep it until v1_claims is empty.
NPUBCASH_V1_SEED=
# The fork's JWT_SECRET, so payment tokens it issued still verify.
NPUBCASH_V1_JWT_SECRET=
# The fork's MINTURL, verbatim.
NPUBCASH_V1_MINT_URL=https://mint.example
# Hex pubkey of the Linky account that collects username fees.
NPUBCASH_V1_OPERATOR_PUBKEY=
NPUBCASH_V1_WORKER_INTERVAL_MS=5000
