    "react-native": "0.86.3",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "@linky-fit/config": "workspace:*",
    "@types/bun": "^1.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "babel-preset-expo": "~57.0.13",
    "esbuild": "0.27.3",
    "eslint": "^9.39.1",
    "jiti": "^2.7.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
