{
  "name": "@linky-fit/expo",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "bun scripts/preparePublic.ts && expo start --web --port 5180",
    "build": "NODE_ENV=production bun scripts/build.ts",
    "preview": "bun scripts/serve.ts 5181",
    "typecheck": "tsc -b",
    "eslint": "eslint --fix .",
    "prettier": "prettier --write .",
    "test": "bun test src",
    "native:prebuild": "expo prebuild --clean",
    "start:native": "expo start --dev-client",
    "android:debug": "bun scripts/adbReverse.ts && expo run:android --device",
    "android:release": "expo run:android --device --variant release",
    "ios:debug": "expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release",
    "export:native": "NODE_ENV=production expo export --platform android --platform ios --output-dir dist-native"
  },
  "dependencies": {
    "@evolu/common": "7.4.1",
    "@evolu/react": "10.4.0",
    "@evolu/react-native": "14.3.0",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@linky-fit/identity": "workspace:*",
    "@linky-fit/linkstr": "workspace:*",
    "@linky-fit/linksync": "workspace:*",
    "@linky-fit/ui": "workspace:*",
    "@linky-fit/linky-app": "workspace:*",
    "effect": "^4.0.0",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "@linky-fit/config": "workspace:*",
    "@types/bun": "^1.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "babel-preset-expo": "~57.0.13",
    "esbuild": "0.27.3",
    "eslint": "^9.39.1",
    "jiti": "^2.7.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "workbox-build": "7.4.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
