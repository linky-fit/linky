{
  "name": "@linky/ui-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5192 --strictPort",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint --fix .",
    "prettier": "prettier --write .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@linky/ui": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@linky/config": "workspace:*",
    "@playwright/test": "^1.58.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "prettier": "@linky/config/prettier"
}
