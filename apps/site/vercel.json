{
  "rewrites": [
    {
      "source": "/p/:id/picture",
      "destination": "/api/profile-picture?id=:id"
    },
    {
      "source": "/p/:id",
      "destination": "/api/profile?id=:id"
    },
    {
      "source": "/.well-known/lnurlp/:user",
      "destination": "/api/lnurlp/:user"
    },
    {
      "source": "/.well-known/nostr.json",
      "destination": "/api/nostr"
    },
    {
      "source": "/recommended-relays",
      "destination": "/recommended-relays.json"
    }
  ],
  "headers": [
    {
      "source": "/recommended-relays(.json)?",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
