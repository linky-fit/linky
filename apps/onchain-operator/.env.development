# Linky's local dev services from docker-compose.dev.yml (repo root) and its
# regtest profile (`bun run bitcoin:up`). `bun run dev` (vite development mode) loads this file.
VITE_NOSTR_RELAYS=ws://localhost:7777
VITE_EVOLU_SERVER_URLS=ws://localhost:4001
VITE_MAIN_MINT_URL=http://localhost:3338
VITE_ALLOW_INSECURE_LOCALHOST_RELAYS=1
VITE_BITCOIN_NETWORK=regtest
VITE_ESPLORA_URL=http://localhost:3002
VITE_EXPLORER_URL=http://localhost:3003
