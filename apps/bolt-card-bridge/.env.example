BOLT_CARD_BRIDGE_PORT=8789
# The public https origin POS terminals reach; LNURL callbacks are built from it.
BOLT_CARD_BRIDGE_PUBLIC_URL=https://bolt-card.example.com
# Empty by default. Set only the exact IPs of reverse proxies you control.
BOLT_CARD_BRIDGE_TRUSTED_PROXY_IPS=
BOLT_CARD_BRIDGE_REQUEST_TIMEOUT_MS=5000
BOLT_CARD_BRIDGE_AUTH_TIMEOUT_MS=10000
BOLT_CARD_BRIDGE_MAX_SESSION_MS=600000
# How long a POS request waits for a card that is still connecting, and how
# many such requests may wait per card and in total.
BOLT_CARD_BRIDGE_SESSION_WAIT_MS=3000
BOLT_CARD_BRIDGE_MAX_WAITERS_PER_CARD=4
BOLT_CARD_BRIDGE_MAX_WAITERS=1000
BOLT_CARD_BRIDGE_RATE_LIMIT_IP_MAX=120
BOLT_CARD_BRIDGE_RATE_LIMIT_CARD_MAX=30
BOLT_CARD_BRIDGE_RATE_LIMIT_WINDOW_MS=60000
# 1: one redacted line per message between POS, bridge and card.
# raw: also every HTTP request and WebSocket frame verbatim, k1 included;
# never in production.
BOLT_CARD_BRIDGE_DEBUG=0
