# Local dev config, auto-loaded by Bun when NODE_ENV is unset/development, and
# the env_file of the `supporter` service in docker-compose.dev.yml.
# The recovery seed is dev-only and committed on purpose: it never holds real
# funds and is never used outside the local stack. Its npub, the dev Linky Bot,
# is npub1yagmakxydfdeqpfeun3qryk8r38mrwp6apuyaf3j3qdupc5vkjhsjg0qg2.
SUPPORTER_RECOVERY_SEED="flame lilac academic academic answer rich depict glance physics formal evaluate practice mortgage screw club change firefly payroll install romp"
SUPPORTER_PORT=8788
SUPPORTER_STORAGE_PATH=./data/linky-supporter-dev.sqlite
SUPPORTER_RELAYS=ws://localhost:7777
SUPPORTER_ALLOW_INSECURE_LOCALHOST_RELAYS=1
SUPPORTER_ACCEPTED_MINTS=http://localhost:3338,https://testnut.cashu.space
